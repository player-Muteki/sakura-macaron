{
  "name": "sakura-macaron",
  "displayName": "Sakura Macaron",
  "description": "樱花马卡龙配色主题 — 深色夜樱与亮色樱粉的完整独立主题。固定基准覆盖 992 个工作台颜色键、80 条 TextMate 规则与 94 项语义高亮，含 Modern UI、AI Chat、Git、终端、Diff、调试与测试配色。",
  "version": "0.1.1",
  "publisher": "player-muteki",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/player-Muteki/sakura-macaron.git"
  },
  "homepage": "https://github.com/player-Muteki/sakura-macaron#readme",
  "bugs": {
    "url": "https://github.com/player-Muteki/sakura-macaron/issues"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "color theme",
    "dark",
    "light",
    "dark theme",
    "light theme",
    "sakura",
    "macaron",
    "pastel",
    "soft",
    "樱花",
    "马卡龙",
    "樱粉",
    "护眼",
    "柔和",
    "粉色",
    "vscode theme"
  ],
  "galleryBanner": {
    "color": "#C45A6D",
    "theme": "dark"
  },
  "icon": "icon.png",
  "contributes": {
    "themes": [
      {
        "label": "Sakura Macaron Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/sakura-macaron-dark.json"
      },
      {
        "label": "Sakura Macaron Light",
        "uiTheme": "vs",
        "path": "./themes/sakura-macaron-light.json"
      }
    ]
  },
  "scripts": {
    "check": "node scripts/check-theme.mjs && node scripts/check-schema.mjs",
    "check:contrast": "python scripts/check_contrast.py --strict",
    "check:generated": "python scripts/build_themes.py --check && python scripts/build_tokens.py --check",
    "build": "python scripts/build_themes.py",
    "registry:update": "python scripts/update_registry.py",
    "test": "node --test scripts/tests/validation.test.mjs && python -m unittest discover -s scripts/tests -p test_*.py",
    "verify": "npm run check && npm run check:generated && npm run check:contrast && npm test",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run verify"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
