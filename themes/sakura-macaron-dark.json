{
  "$schema": "vscode://schemas/color-theme",
  "name": "Sakura Macaron Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#CBA8B9",
    "class": "#E27E7E",
    "enum": "#E27E7E",
    "enumMember": "#F2D299",
    "function": "#CBA8B9",
    "interface": "#E27E7E",
    "struct": "#E27E7E",
    "typeParameter": "#E27E7E",
    "parameter": "#CBA8B9",
    "variable": "#CCCCCC",
    "variable.readonly": "#85B59A",
    "variable.defaultLibrary": "#85B59A",
    "property": "#9B8A9E",
    "property.static": "#E27E7E",
    "event": "#E27E7E",
    "function.defaultLibrary": "#CBA8B9",
    "method": "#CBA8B9",
    "macro": "#D6A461",
    "label": "#F2D299",
    "comment": "#9B8A9E",
    "string": "#85B59A",
    "keyword": "#87A3D6",
    "number": "#F2D299",
    "regexp": "#85B59A",
    "operator": "#A3B1D6",
    "decorator": "#F2D299",
    "type": "#E27E7E",
    "tag": "#87A3D6",
    "selfKeyword": "#87A3D6",
    "newKeyword": "#87A3D6",
    "controlKeyword": "#87A3D6",
    "otherKeyword": "#87A3D6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9B8A9E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#87A3D6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#CBA8B9"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#85B59A"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#F2D299"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "meta.type.cast"
      ],
      "settings": {
        "foreground": "#E27E7E"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#D6A461"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#87A3D6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.id",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#9B8A9E"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#9B8A9E"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#A3B1D6"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.namespace",
        "meta.namespace"
      ],
      "settings": {
        "foreground": "#CBA8B9"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "meta.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#F2D299"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C25B5B"
      }
    }
  ],
