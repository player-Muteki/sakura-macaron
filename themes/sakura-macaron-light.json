{
  "$schema": "vscode://schemas/color-theme",
  "name": "Sakura Macaron Light",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#327A85",
    "class": "#875C96",
    "enum": "#875C96",
    "enumMember": "#D8823B",
    "function": "#327A85",
    "interface": "#875C96",
    "struct": "#875C96",
    "typeParameter": "#875C96",
    "parameter": "#327A85",
    "variable": "#3A3132",
    "variable.readonly": "#6B965C",
    "variable.defaultLibrary": "#6B965C",
    "property": "#6A8A76",
    "property.static": "#875C96",
    "event": "#875C96",
    "function.defaultLibrary": "#327A85",
    "method": "#327A85",
    "macro": "#D8823B",
    "label": "#D8823B",
    "comment": "#6A8A76",
    "string": "#6B965C",
    "keyword": "#C84B5D",
    "number": "#D8823B",
    "regexp": "#6B965C",
    "operator": "#C45A6D",
    "decorator": "#D8823B",
    "type": "#875C96",
    "tag": "#C84B5D",
    "selfKeyword": "#C84B5D",
    "newKeyword": "#C84B5D",
    "controlKeyword": "#C84B5D",
    "otherKeyword": "#C84B5D"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6A8A76",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C84B5D"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#327A85"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6B965C"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#D8823B"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "meta.type.cast"
      ],
      "settings": {
        "foreground": "#875C96"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#3A3132"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#C07A3A"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C84B5D"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.id",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#6A8A76"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#BFA4AE"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#C45A6D"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.namespace",
        "meta.namespace"
      ],
      "settings": {
        "foreground": "#327A85"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "meta.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#D8823B"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#7E2A3C"
      }
    }
  ],
